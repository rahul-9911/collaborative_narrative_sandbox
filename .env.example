# .env - StoryForge Configuration

# --- AI CONFIGURATION ---
GEMINI_API_KEY=your_google_ai_studio_key_here
AI_PROVIDER=GEMINI # Switch to 'LOCAL' for Ollama
LOCAL_MODEL_NAME=llama3 # The model you want to run on your GPU

# --- DATABASE CONFIGURATION ---
DB_USER=storyforge
DB_PASSWORD=password123
DB_NAME=storyforge_v1
DB_PORT=5432
DB_HOST=localhost

# --- SERVER CONFIGURATION ---
PORT=3000
NODE_ENV=development
